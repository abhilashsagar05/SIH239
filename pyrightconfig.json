{
  "venvPath": "./backend",
  "venv": ".venv",
  "pythonVersion": "3.13",
  "pythonPlatform": "Windows",
  "include": ["backend/app", "ai_engine"],
  "exclude": ["**/__pycache__", "backend/.venv", "frontend"],
  "extraPaths": ["backend", "."],
  "typeCheckingMode": "basic",
  "reportMissingImports": "warning",
  "reportMissingModuleSource": "none",
  "useLibraryCodeForTypes": true
}
